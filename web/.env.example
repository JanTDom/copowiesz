# Opcjonalnie: Gemini do rozmowy. Klucz tylko na serwerze.
# Lokalnie można go dodać w aplikacji: Ustawienia → Połącz Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Opcjonalna chmura Supabase. Lokalnie aplikacja działa bez tych wartości.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcjonalny LOKALNY model obrazu. Analiza Gemini wymaga osobnej zgody w aplikacji.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=
